#!/usr/bin/env bash
# Pre-push gate for ha-fado (Python-only integration; static JS frontend has no
# build/tests). Strategy: cheap lint first (what usually breaks), then drift
# checks (i18n, docs), then the slower test+coverage run — and only for the
# areas whose files actually changed in this push.
#
# Tests run against whatever Home Assistant is installed in this environment
# (i.e. HA-stable in the devcontainer); the hook does NOT reproduce CI's
# min/dev version matrix — that stays in CI.
#
# Install once per clone:  bash bin/install-hooks.sh
# Bypass in an emergency:  git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
LOG_FILE="/tmp/fado-pre-push.log"
failed=0
exec > >(tee "$LOG_FILE") 2>&1

step() { printf '\n\033[1;34m▶ %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$1"; failed=1; }
pass() { printf '\033[1;32m✓ %s\033[0m\n' "$1"; }
need() { command -v "$1" >/dev/null 2>&1 || { fail "$1 not found — are you pushing from the devcontainer? (deps expected there)"; return 1; }; }

# --- Compute the precise diff range from the refs git feeds us on stdin ---
ZERO=0000000000000000000000000000000000000000
default_base() {
  for ref in origin/main main origin/HEAD; do
    git rev-parse --verify --quiet "$ref" >/dev/null 2>&1 && { echo "$ref"; return; }
  done
  echo "HEAD~1"
}
range=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # branch deletion: nothing to test
  if [ "$remote_sha" = "$ZERO" ]; then              # new branch on the remote
    base="$(git merge-base "$(default_base)" "$local_sha" 2>/dev/null || default_base)"
    range="${base}..${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi
done
[ -n "$range" ] || range="$(default_base)..HEAD"

# The remote SHA in the range may be absent locally (shallow clone, not fetched
# recently) — fall back to a base we know exists so downstream consumers of the
# range (e.g. check_docs.py, which has no fallback of its own) don't crash on an
# invalid revision.
range_base="${range%%..*}"
git rev-parse --verify --quiet "${range_base}^{commit}" >/dev/null 2>&1 || range="$(default_base)..HEAD"

changed="$(git diff --name-only "$range" 2>/dev/null || git diff --name-only HEAD~1)"
echo "pre-push: $(printf '%s\n' "$changed" | grep -c . || true) changed file(s) in range $range"

py_changed=$(printf '%s\n' "$changed"   | grep -E '^(custom_components/fado/|tests/).*\.py$' || true)
i18n_changed=$(printf '%s\n' "$changed" | grep -E '^custom_components/fado/(strings\.json|translations/)' || true)
site_changed=$(printf '%s\n' "$changed" | grep -E '^(docs/|mkdocs\.yml|requirements-docs\.txt|CHANGES\.md)' || true)
demo_changed=$(printf '%s\n' "$changed" | grep -E '^(demo/|tests/frontend/|docs/)' || true)

# --- Step 1: fast lint/format (Python) ---
if [ -n "$py_changed" ]; then
  step "Ruff format"
  if need ruff && ruff format --check custom_components/fado tests; then pass "Ruff format"
  else fail "Ruff format — run: ruff format custom_components/fado tests"; fi

  step "Ruff lint"
  if need ruff && ruff check custom_components/fado tests; then pass "Ruff lint"
  else fail "Ruff lint — run: ruff check --fix custom_components/fado tests"; fi
fi

# --- Step 2: i18n drift (when strings/translations or any Python changed) ---
# --strict: a string added to strings.json but not yet translated into every
# language fails the push, so a new key can't slip through to a release
# English-only (the default check only errors on *stale* keys).
if [ -n "$i18n_changed$py_changed" ]; then
  step "Translations"
  if python3 "$ROOT/scripts/check_translations.py" --strict; then pass "Translations"
  else fail "Translations — translate the missing keys (or git push --no-verify to bypass)"; fi
fi

# --- Step 3: docs drift ---
step "Docs"
if python3 "$ROOT/scripts/check_docs.py" "$range"; then pass "Docs"
else fail "Docs — structural change needs a docs update"; fi

# --- Step 3b: docs site + demo build ---
# mkdocs --strict turns a broken internal link into a failure; the demo build
# plus the frontend suite catch a link rewritten to a page that doesn't exist.
if [ -n "$site_changed" ]; then
  step "Docs site build"
  if need mkdocs && (cd "$ROOT" && mkdocs build --strict --site-dir /tmp/fado-mkdocs-check); then
    pass "Docs site build"
  else
    fail "Docs site build — run: mkdocs build --strict"
  fi
fi

if [ -n "$demo_changed" ]; then
  step "Demo build + link checks"
  if need npm && (cd "$ROOT/demo" && npm run build:pages >/dev/null 2>&1) \
              && (cd "$ROOT" && npm test >/dev/null 2>&1); then
    pass "Demo build + link checks"
  else
    fail "Demo build + link checks — run: (cd demo && npm run build:pages) && npm test"
  fi
fi

# --- Step 4: tests + coverage (slower; only if Python changed) ---
if [ -n "$py_changed" ]; then
  step "Tests + coverage"
  if need python3 && (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; \
       python3 -m pytest tests/ --cov=custom_components.fado --cov-report=term-missing --cov-fail-under=90); then
    pass "Tests + coverage"
  else
    fail "Tests + coverage"
  fi
fi

# --- Result ---
echo ""
if [ "$failed" -ne 0 ]; then
  printf '\033[1;31m✗ Pre-push checks failed. Push aborted.\033[0m\n\n\033[1mFailures:\033[0m\n'
  perl -pe 's/\e\[[0-9;]*m//g' "$LOG_FILE" | grep -E "^✗ " | sed 's/^/  /'
  printf '\n\033[1mFull log:\033[0m %s\n' "$LOG_FILE"
  exit 1
fi
printf '\033[1;32m✓ All pre-push checks passed.\033[0m\n'
